<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme for Android 12+ (API 31+).
         Drives the system SplashScreen API. The icon and background here are
         shown by the OS during cold start, then the activity transitions to
         the launch_background.xml drawable. Background colors match so the
         hand-off is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
