# Tichu Online — environment variables template
#
# Copy to .env at repo root and fill in real values. The actual .env is
# gitignored. On the VPS this same file lives at
# /opt/services/tichu-online/app/.env and is read by docker compose.

# ─── Database (postgres container) ────────────────────────────────────
DB_NAME=tichu
DB_PASSWORD=change-me-please

# Connection string used by the server. Hostname `tichu-db` is the
# postgres container's DNS name on app-network.
DATABASE_URL=postgresql://tichu:change-me-please@tichu-db:5432/tichu?sslmode=disable

# ─── Firebase / push (server) ─────────────────────────────────────────
# Full JSON of a Firebase service account, single-quoted.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}'

# ─── In-app purchase: Apple (StoreKit 2 / App Store Server) ───────────
# Expected iOS bundle id. Verifies JWS transactions and rejects
# notifications meant for other apps. No .p8 / shared secret needed
# (StoreKit 2 JWS is verified offline against Apple Root CA-G3).
# APPLE_BUNDLE_ID=com.jiny.tichuOnline
#
# OPTIONAL — only for replying to CONSUMPTION_REQUEST (consumable refund
# review). Without these we still record the request; with them we send
# consumption info to Apple to curb refund abuse. App Store Connect API
# in-app-purchase key (.p8). Private key keeps literal \n (code un-escapes).
# APPLE_ASC_KEY_ID=ABCD123456
# APPLE_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# APPLE_ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── In-app purchase: Google Play ─────────────────────────────────────
# Play Console package name + a service account with "View financial
# data / Manage orders" access. Same SA is reused for refund (voided
# purchases) polling — no extra credentials/webhook needed.
# Private key keeps literal \n (the code un-escapes them).
# GOOGLE_PLAY_PACKAGE_NAME=com.jiny.tichuOnline
# GOOGLE_PLAY_SA_EMAIL=tichu-iap@your-project.iam.gserviceaccount.com
# GOOGLE_PLAY_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Android app links (assetlinks.json) ──────────────────────────────
# Comma-separated SHA-256 fingerprints of the signing certs that should
# be allowed to deep-link. Leave commented to fall back to defaults.
# ANDROID_APP_SHA256_FINGERPRINTS=...

# ─── Blue/green migration (zero-downtime deploy) ──────────────────────
# Shared secret between server-blue and server-green so each can adopt
# rooms migrated from the other when SIGTERM hits. Generate with:
#   openssl rand -hex 32
INTERNAL_MIGRATE_TOKEN=change-me-please-32-bytes-of-random-hex
